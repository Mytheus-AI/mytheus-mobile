{
  "expo": {
    "name": "Mytheus",
    "slug": "mytheus-mobile",
    "version": "0.1.0",
    "scheme": "mytheus",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F0EEE6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.mytheus.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mytheus uses the microphone when you join a meeting or record one in a room, so your agent can follow along. It is off outside meetings.",
        "NSCameraUsageDescription": "Mytheus uses the camera only when you turn it on in a meeting.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ai.mytheus.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0EEE6"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EEE6",
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1A1816",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-asset",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Mytheus uses the camera only when you turn it on in a meeting.",
          "microphonePermission": "Mytheus uses the microphone when you join a meeting, so people hear you and your agent can follow along."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c15f3c"
        }
      ],
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": true,
          "enableBackgroundAudio": true,
          "enableDeviceDetection": false,
          "iosBackgroundModes": {
            "useAudio": true,
            "useVoIP": false,
            "useProcessing": false,
            "useLocation": false,
            "useExternalAccessory": false
          },
          "iosConfig": {
            "microphoneUsageDescription": "Mytheus uses the microphone when you join a meeting or record one in a room, so your agent can follow along. It is off outside meetings."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png"
  }
}
