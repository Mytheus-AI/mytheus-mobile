{
  "expo": {
    "name": "Mytheus",
    "slug": "mytheus-mobile",
    "version": "0.1.0",
    "scheme": "mytheus",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F0EEE6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.mytheus.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mytheus listens to your in-person meeting on this device to transcribe and summarize it. Audio stays on the device until you finish a session."
      }
    },
    "android": {
      "package": "ai.mytheus.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0EEE6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EEE6",
          "resizeMode": "contain",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png"
  }
}
