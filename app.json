{
  "expo": {
    "name": "Reprise",
    "slug": "reprise-mobile",
    "version": "0.1.0",
    "scheme": "reprise",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F0EEE6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.reprise.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Reprise listens to your in-person meeting on this device to transcribe and summarize it. Audio stays on the device until you finish a session."
      }
    },
    "android": {
      "package": "ai.reprise.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EEE6",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
