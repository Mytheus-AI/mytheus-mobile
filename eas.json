{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_GATEWAY_URL": "https://api.mytheus.cloud",
        "EXPO_PUBLIC_REALTIME_WS_URL": "wss://api.mytheus.cloud"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_GATEWAY_URL": "https://api.mytheus.cloud",
        "EXPO_PUBLIC_REALTIME_WS_URL": "wss://api.mytheus.cloud"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
