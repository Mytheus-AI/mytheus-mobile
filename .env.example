# mytheus-mobile / .env.example - copy to .env and fill. Never commit .env.
#
# EXPO_PUBLIC_* values ship inside the JS bundle, which is fully extractable from a shipped
# app. Only publishable values belong here. A LiveKit API secret, a Deepgram key, an LLM key
# or a Clerk BACKEND key in this file is a credential leak the moment the app is released,
# and rotating it means shipping a new build to every device.

# Clerk publishable key (pk_test_... / pk_live_...). Safe to ship by design.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# The api-gateway origin, and the ONLY backend address this client knows. Never a service URL:
# going direct to core-api or bff would bypass the edge that derives org_id from the token.
# There is deliberately no default in code, so a missing value fails loudly at startup rather
# than sending real bearer tokens to somewhere unintended.
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Later bands. Present here so the shape of a full environment is visible, unused for now:
# realtime lands with Plan 3-4 and LiveKit with the media thread.
# EXPO_PUBLIC_REALTIME_WS_URL=
# EXPO_PUBLIC_LIVEKIT_URL=
# EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
