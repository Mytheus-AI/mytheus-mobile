# Public, client-readable values only. Never put a secret here: the bundle is extractable.
# Without these the app shows "not connected to a workspace" (there are no defaults on purpose).
EXPO_PUBLIC_API_GATEWAY_URL=https://api.mytheus.cloud
EXPO_PUBLIC_REALTIME_WS_URL=wss://api.mytheus.cloud
# The Clerk publishable key of the same instance mytheus-ui uses (pk_live_... / pk_test_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
